    r"koi\s+nahi\s+(?:hai|tha)\s+(?:mere|liye)",
    r"akela\s*(?:ho|hun|hona)",
]
_TRANS_HELP_SEEKING = [
    r"madad\s*(?:chahiye|kar)",
    r"koi\s+hai\s+jo",
    r"kya\s+karon",
]

_DEVA_HARM = [
    r"आत्महत्या",
    r"आत्म हत्या",
    r"मरना\s*चाहता",
    r"मरना\s*चाहती",
